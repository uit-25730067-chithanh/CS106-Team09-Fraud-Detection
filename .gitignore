# CS106 Final — Global .gitignore

# Dataset (too large to commit)
**/data/raw/*.csv
**/data/raw/creditcard.csv

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Model artifacts (large trained models > 50MB — theo quy tắc plan.md)
# PKL nhỏ (scaler.pkl ~1KB, processed splits ~18MB tổng) → được commit để team sử dụng
**/models/*.pkl
!**/models/scaler.pkl
models/*.h5
models/*.joblib

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
.env

# Local Streamlit demo state
**/demo/.data/

# Office temp lock files
~$*
